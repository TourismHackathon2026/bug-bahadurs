# Database
DATABASE_URL=postgresql://user:password@localhost:5432/awaaz
UPLOADTHING_TOKEN=
# Session
SESSION_SECRET=your-32-byte-random-secret-here

# Object Storage
STORAGE_BUCKET=awaaz-uploads
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# AI
GEMINI_API_KEY=your-gemini-api-key

# SMTP / Mailpit (docker: localhost:1025, ui: localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@awaaz.gov.np

# Redis (optional — set to redis://localhost:6379 to enable caching)
REDIS_URL=redis://localhost:6379

# Feature Flags (server)
FF_AI_CATEGORIZATION=true
FF_TRANSLATION=true
FF_HEATMAP=true
FF_MAP_PIN=true

# Feature Flags (client)
NEXT_PUBLIC_FF_MAP_PIN=true
NEXT_PUBLIC_FF_AI_CATEGORIZATION=true
NEXT_PUBLIC_FF_TRANSLATION=true
NEXT_PUBLIC_FF_HEATMAP=true