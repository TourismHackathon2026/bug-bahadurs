# Docker development environment for Awaaz
# Copy this file to .env or use it with a Docker-specific env loader.

# Postgres connection for local Docker Compose
DATABASE_URL=postgresql://aawaz:aawaz_password@postgres:5432/awaaz

# Local UploadThing token placeholder (keep original value for production)
UPLOADTHING_TOKEN='your-uploadthing-token'

# Session secret should be 48 bytes for secure cookie signing
SESSION_SECRET=replace-with-a-48-byte-random-secret

NVIDIA_API_KEY = 'nvapi-'
NVIDIA_API_URL = 'https://integrate.api.nvidia.com/v1'
NVIDIA_MODEL='meta/llama-4-maverick-17b-128e-instruct'

# Object storage can remain unset when using local uploads or mock storage
STORAGE_BUCKET=awaaz-uploads
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# AI / feature configuration
GEMINI_API_KEY=your-gemini-api-key

FF_AI_CATEGORIZATION=true
FF_TRANSLATION=true
FF_HEATMAP=true
FF_MAP_PIN=true

NEXT_PUBLIC_FF_MAP_PIN=true
NEXT_PUBLIC_FF_AI_CATEGORIZATION=true
NEXT_PUBLIC_FF_TRANSLATION=true
NEXT_PUBLIC_FF_HEATMAP=true

# Optional Redis URL for session or pub/sub support
REDIS_URL=redis://redis:6379
